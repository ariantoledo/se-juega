{
  "name": "FieldNewReservation",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "format": "email",
      "description": "Email del usuario"
    },
    "user_name": {
      "type": "string",
      "description": "Nombre del usuario"
    },
    "field_new_id": {
      "type": "string",
      "description": "ID de la cancha"
    },
    "field_name": {
      "type": "string",
      "description": "Nombre de la cancha"
    },
    "establishment_id": {
      "type": "string",
      "description": "ID del establecimiento"
    },
    "timeslot_id": {
      "type": "string",
      "description": "ID del horario"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Fecha de la reserva (YYYY-MM-DD)"
    },
    "start_time": {
      "type": "string",
      "pattern": "^\\d{2}:\\d{2}$",
      "description": "Hora de inicio (HH:MM)"
    },
    "end_time": {
      "type": "string",
      "pattern": "^\\d{2}:\\d{2}$",
      "description": "Hora de fin (HH:MM)"
    },
    "payment_type": {
      "type": "string",
      "enum": [
        "sena",
        "total"
      ],
      "description": "Tipo de pago (se\u00f1a o total)"
    },
    "amount_paid": {
      "type": "number",
      "minimum": 0,
      "description": "Monto pagado en ARS"
    },
    "precio_total": {
      "type": "number",
      "minimum": 0,
      "description": "Precio total de la cancha en ARS"
    },
    "commission_amount": {
      "type": "number",
      "const": 2000,
      "description": "Comisi\u00f3n fija de la app (2000 ARS por reserva)"
    },
    "owner_amount": {
      "type": "number",
      "description": "Monto para el due\u00f1o (precio_total - 2000)"
    },
    "reservation_status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "cancelled"
      ],
      "default": "pending",
      "description": "Estado de la reserva"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "refunded"
      ],
      "default": "pending",
      "description": "Estado del pago"
    },
    "mercadopago_payment_id": {
      "type": "string",
      "description": "ID del pago de Mercado Pago"
    },
    "match_id": {
      "type": "string",
      "description": "ID del partido vinculado (opcional)"
    }
  },
  "required": [
    "user_email",
    "field_new_id",
    "date",
    "start_time",
    "end_time",
    "payment_type",
    "amount_paid"
  ]
}