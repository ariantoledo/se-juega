{
  "name": "MatchReminder",
  "type": "object",
  "properties": {
    "match_id": {
      "type": "string",
      "description": "ID del partido"
    },
    "user_email": {
      "type": "string",
      "format": "email",
      "description": "Email del jugador notificado"
    },
    "sent_at": {
      "type": "string",
      "description": "Timestamp de env\u00edo"
    }
  },
  "required": [
    "match_id",
    "user_email"
  ]
}