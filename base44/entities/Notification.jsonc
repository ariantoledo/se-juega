{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "format": "email",
      "description": "Email del destinatario"
    },
    "title": {
      "type": "string",
      "description": "T\u00edtulo de la notificaci\u00f3n"
    },
    "message": {
      "type": "string",
      "description": "Mensaje completo"
    },
    "type": {
      "type": "string",
      "enum": [
        "match",
        "request",
        "reservation",
        "system",
        "payment"
      ],
      "description": "Tipo de notificaci\u00f3n"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "description": "Si la notificaci\u00f3n ya fue le\u00edda"
    },
    "link": {
      "type": "string",
      "description": "URL interna de acci\u00f3n (opcional)"
    }
  },
  "required": [
    "user_email",
    "title",
    "message",
    "type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "system"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}