{
  "name": "PlayerAvailability",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "format": "email",
      "description": "Email del jugador"
    },
    "user_name": {
      "type": "string",
      "description": "Nombre del jugador"
    },
    "slots": {
      "type": "array",
      "description": "Horarios disponibles",
      "items": {
        "type": "object",
        "properties": {
          "day": {
            "type": "string",
            "enum": [
              "lunes",
              "martes",
              "mi\u00e9rcoles",
              "jueves",
              "viernes",
              "s\u00e1bado",
              "domingo"
            ]
          },
          "start_time": {
            "type": "string",
            "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$",
            "description": "Hora de inicio (HH:mm)"
          },
          "end_time": {
            "type": "string",
            "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$",
            "description": "Hora de fin (HH:mm)"
          }
        },
        "required": [
          "day",
          "start_time",
          "end_time"
        ]
      }
    },
    "notify_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Si acepta recibir notificaciones de partidos"
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}