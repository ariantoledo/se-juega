{
  "name": "OwnerRequest",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "format": "email",
      "description": "Email del solicitante"
    },
    "user_name": {
      "type": "string",
      "description": "Nombre del solicitante"
    },
    "establishment_name": {
      "type": "string",
      "description": "Nombre del establecimiento"
    },
    "address": {
      "type": "string",
      "description": "Direcci\u00f3n del establecimiento"
    },
    "phone": {
      "type": "string",
      "pattern": "^[0-9\\-\\+\\s]{7,15}$",
      "description": "Tel\u00e9fono de contacto"
    },
    "document_info": {
      "type": "string",
      "description": "N\u00famero de documento o identificaci\u00f3n"
    },
    "evidence_url": {
      "type": "string",
      "format": "uri",
      "description": "URL de imagen/archivo de evidencia"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "cancelled"
      ],
      "default": "pending",
      "description": "Estado de la solicitud"
    },
    "admin_notes": {
      "type": "string",
      "description": "Notas del administrador"
    }
  },
  "required": [
    "user_email",
    "user_name",
    "establishment_name",
    "address",
    "phone",
    "document_info"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}